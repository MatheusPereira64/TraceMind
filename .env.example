# ---------------------------------------------------------------------------
# docker-compose.yml (full stack)
# ---------------------------------------------------------------------------
POSTGRES_USER=tracemind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracemind

# Required. Generate with: openssl rand -base64 48
JWT_SECRET=

# Exact dashboard origin(s), comma separated.
WEB_ORIGIN=http://localhost:3000
# URL applications use to reach the ingestion API (shown in setup snippets).
PUBLIC_API_URL=http://localhost:4000
# true when served over HTTPS
COOKIE_SECURE=false
# true only when the API is reachable exclusively through a trusted reverse proxy
TRUST_PROXY=false
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Local development (pnpm dev) — apps/api reads these from the environment
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://tracemind:tracemind@localhost:5432/tracemind
# DATABASE_URL_TEST=postgres://tracemind:tracemind@localhost:5432/tracemind_test
# REDIS_URL=redis://localhost:6379
# PORT=4000
# RATE_LIMIT_PER_MINUTE=300
# AUTH_RATE_LIMIT_PER_MINUTE=10
# JWT_TTL_SECONDS=43200
