{
  "name": "@tracemind/api",
  "version": "0.1.0",
  "private": true,
  "description": "TraceMind REST API: authentication, tenancy, telemetry ingestion and analytics.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "db:studio": "drizzle-kit studio",
    "pricing:sync": "node --import tsx src/pricing/sync.ts",
    "pricing:sync:prod": "node dist/pricing/sync.js",
    "demo:seed": "node --import tsx src/demo/seed-demo.ts",
    "demo:seed:prod": "node dist/demo/seed-demo.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/throttler": "^6.7.1",
    "@tracemind/shared": "workspace:*",
    "bullmq": "^6.7.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tracemind/sdk": "workspace:*",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "files": [
    "dist",
    "drizzle",
    "pricing"
  ]
}
