# Production settings for docker-compose.prod.yml. Copy to .env.production (never commit it):
#
#   cp .env.production.example .env.production && chmod 600 .env.production

# Public domain. Its DNS A/AAAA record must point at this server before the first start,
# so Caddy can obtain the TLS certificate.
TRACEMIND_DOMAIN=tracemind.example.com
# Let's Encrypt account e-mail (expiry and incident notices).
ACME_EMAIL=you@example.com

POSTGRES_USER=tracemind
POSTGRES_DB=tracemind
# openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=

# Set to false after creating your account so nobody else can sign up.
REGISTRATION_ENABLED=true

LOG_LEVEL=info
# Image tag for builds; set it to a release (e.g. a git tag) to make rollbacks easy.
TRACEMIND_VERSION=latest
INGESTION_CONCURRENCY=4
INGEST_RATE_LIMIT_PER_MINUTE=600
RETENTION_ENABLED=true
RETENTION_CRON=17 3 * * *

# Only for the optional `otel` profile: a project API key that receives collector traffic.
TRACEMIND_COLLECTOR_API_KEY=
